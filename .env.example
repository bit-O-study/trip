# Application
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Supabase - Trip 전용 프로젝트를 사용한다.
# 앱 테이블과 프로필은 public 이 아니라 trip 스키마에 있다. supabase/README.md 참고.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps JavaScript API (browser key; website + API restrictions required)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# 마이그레이션 적용용 (db push). 서비스 역할 키로는 DDL 을 실행할 수 없다.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_URL=

# Kakao login / Local Search (Google Places migration pending)
KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_JS_KEY=

# Google OAuth (configured through Supabase Auth)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Flight data (server-only). 공급자 미확정 - docs/adr/0001-flight-data-provider.md 참고
# KAC_GW = 공공데이터포털 "한국공항공사_실시간 항공기 운항정보 조회_GW" (구 운항정보 API는 2026-06 폐기)
KAC_GW_API_KEY=
AERODATABOX_API_KEY=

# Naver 검색 - v1.1 후기·사진 보강 전용, 좌표 미사용 (server-only)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Deployment automation (not required to run locally)
VERCEL_TOKEN=
VERCEL_OIDC_TOKEN=
